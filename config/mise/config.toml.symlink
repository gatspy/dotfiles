# 三端通用 mise 配置文件 (Windows x64 / 2019 MBP Intel / Mac mini M6 Silicon)
# Mac 路径: ~/.config/mise/config.toml
# Win 路径: C:\Users\<用户名>\.config\mise\config.toml

[settings]
npm.package_manager = "bun"
cargo.binstall = true
pipx.uvx = true
pipx.registry_url = "https://pypi.tuna.tsinghua.edu.cn/simple/{}/"
python.precompiled_flavor = "install_only_stripped"
# rustup/cargo home 不在此钉死（2026-11-21 裁定）：Windows 侧尊重用户 env
# （CARGO_HOME/RUSTUP_HOME=D:\Program\Develop\rust\...），此前 pin ~/.rustup 曾与
# 用户 env 冲突，把 1.15GB registry 堆进 C 盘 ~\.cargo；mac 侧由 mise/init.zsh 的
# MISE_RUSTUP_HOME/MISE_CARGO_HOME env 保持 ~/.rustup 约定
task.run_auto_install = false
minimum_release_age = "0s"       # 改回 "0s"，彻底消除 release date / cutoff 等一切烦人警告

[settings.url_replacements]
"https://storage.googleapis.com/" = "https://storage.flutter-io.cn/"

[tools]
# ── 1. 核心运行时与构建链 (三端严格对齐) ──────────────────────────
java = "temurin-21"
maven = "latest"
cmake = "latest"
flutter = "3.47.9"
rust = { version = "stable", components = ["rust-analyzer", "clippy", "rust-src"] }
node = "22.21"
python = "3.14"
go = "latest"
zig = "latest"
deno = "latest"
bun = "latest"
pnpm = "latest"
uv = "latest"
pixi = "latest"
codex = "latest"
claude-code = "latest"
ruby = { version = "3.4.8", os = ["macos", "linux"] }

# ── 2. macOS 专属工具 (Windows 自动静默跳过) ─────────────────────
xcodegen = { version = "latest", os = ["macos"] }
"gem:cocoapods" = { version = "latest", os = ["macos"] }
direnv = { version = "latest", os = ["macos", "linux"] }
"cargo:sheldon" = { version = "latest", os = ["macos", "linux"] }
"npm:spoof" = { version = "latest", os = ["macos"] }

# ── 2b. Windows 专属工具 (macOS 自动静默跳过) ─────────────────────
# ffmpeg 走 BtbN 官方预编译秒装；mac 侧由 brew 供满血版（VideoToolbox 硬解 + dylib/头文件）
ffmpeg = { version = "latest", os = ["windows"] }

# ── 3. 显式指定后端的跨端预编译工具 (已实测通过 MBP19) ─────────────
"github:atuinsh/atuin" = "latest"
"aqua:dalance/procs" = "latest"
"aqua:coder3101/protols" = "latest"

# ── 4. 三端通用 CLI 工具 (内置 Registry 预编译) ──────────────────
antigravity-cli = "latest"
bat = "latest"
bottom = "latest"
cheat = "latest"
chezmoi = "latest"
croc = "latest"
duckdb = "latest"
duf = "latest"
dust = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
git-filter-repo = "latest"
jq = "latest"
just = "latest"
kind = "latest"
lsd = "latest"
protobuf = "latest"
ripgrep = "latest"
rtk = "latest"
ruff = "latest"
starship = "latest"
taplo = "latest"
tealdeer = "latest"
tokei = "latest"
usage = "latest"
vivid = "latest"
websocat = "latest"
xh = "latest"
yazi = "latest"
yt-dlp = "latest"
zola = "latest"
zoxide = "latest"

# ── 5. Cargo 后端工具 (含 git-delta，Win/Mini6 拉预编译包，MBP19 自动回退编译) ──
"cargo-binstall" = "latest"
"cargo:git-delta" = "latest"
"cargo:cargo-audit" = "latest"
"cargo:cargo-deny" = { version = "latest", locked = true }
"cargo:cargo-generate" = "latest"
"cargo:crm" = "latest"
"cargo:eva" = "latest"
"cargo:fblog" = "latest"
"cargo:rustscan" = "latest"
"cargo:tre-command" = "latest"
"cargo:trippy" = "latest"
"cargo:typos-cli" = "latest"

# ── 6. Go 工具 ───────────────────────────────────────────────────
"go:github.com/gogf/gf/cmd/gf/v2" = "2.10.2"
"go:github.com/ofabry/go-callvis" = "latest"
"go:github.com/a-h/templ/cmd/templ" = "latest"
"go:github.com/google/wire/cmd/wire" = "latest"

# ── 7. NPM 工具 (通过 bun 极速安装) ──────────────────────────────
"npm:fanyi" = "latest"
"npm:ccusage" = "latest"
"npm:npkill" = "latest"
"npm:prettier" = "latest"
"npm:pake-cli" = "latest"
"npm:http-server" = "latest"
"npm:epub2md" = "latest"
"npm:ignite-cli" = "latest"
"npm:@electron/asar" = "latest"
"npm:@moonshot-ai/kimi-code" = "latest"

# ── 8. Python CLI 工具 (复用全局 Python 3.14 + uvx 隔离运行) ─────
"pipx:duckduckgo-mcp-server" = "latest"
"pipx:pre-commit" = "latest"
"pipx:mycli" = "latest"

[env]
BINSTALL_STRATEGIES = "crate-meta-data,compile"
PIP_INDEX_URL = "https://pypi.tuna.tsinghua.edu.cn/simple/"
UV_DEFAULT_INDEX = "https://pypi.tuna.tsinghua.edu.cn/simple/"
GOPROXY = "https://goproxy.cn,direct"
FLUTTER_STORAGE_BASE_URL = "https://storage.flutter-io.cn"
PUB_HOSTED_URL = "https://pub.flutter-io.cn"
