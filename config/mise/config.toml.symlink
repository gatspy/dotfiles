# mise configuration file
# https://mise.jdx.dev/configuration.html

[settings]
env_shell_expand = true
npm.package_manager = "bun"
cargo.binstall = true
pipx.uvx = true
pipx.registry_url = "https://pypi.tuna.tsinghua.edu.cn/simple/{}/"
task.run_auto_install = false
minimum_release_age = "0s"

[tools]
# Core runtimes
node = "22.16"
python = "3.14"
go = "latest"
ruby = "3.4.8"
rust = "stable"
java = "23"
bun = "latest"
uv = "latest"
zig = "latest"
deno = "latest"
codex = "latest"
claude-code = "latest"
flutter = "3.38.10-stable"

# CLI tools (registry short names; mise resolves the backend per its registry)
rtk = "latest"
dust = "latest"
yazi = "latest"
just = "latest"
starship = "latest"
xh = "latest"
usage = "latest"
chezmoi = "latest"
fzf = "latest"
tokei = "latest"

# Intel exception: the aqua registry defaults for these three carry no darwin/amd64
# assets, so the cargo backend must be pinned explicitly (binstall prebuilt,
# falls back to mise rust source build)
"cargo:atuin" = "latest"
"cargo:git-delta" = "latest"
"cargo:sheldon" = "latest"

# ruff: the registry short name resolves to a stale 0.15.0; pinned to upstream releases
"aqua:astral-sh/ruff" = "latest"

# Cargo tools
"cargo-binstall" = "latest"
"cargo:cargo-deny" = "latest"
"cargo:cargo-generate" = "latest"
"cargo:typos-cli" = "latest"

# Go tools
"go:github.com/gogf/gf/cmd/gf/v2" = "2.10.0"
"go:github.com/ofabry/go-callvis" = "latest"
"go:github.com/a-h/templ/cmd/templ" = "latest"
"go:github.com/kralicky/protols/cmd/protols" = "latest"
"go:github.com/brads3290/cclogviewer/cmd/cclogviewer" = "latest"

"npm:pnpm" = "latest"
"npm:fanyi" = "latest"
"npm:ccusage" = "latest"
"npm:npkill" = "latest"
"npm:prettier" = "latest"
"npm:pake-cli" = "latest"
"npm:http-server" = "latest"
"npm:@google/gemini-cli" = "latest"
"npm:@moonshot-ai/kimi-code" = "latest"

"pipx:duckduckgo-mcp-server" = "latest"
"pipx:pre-commit" = { version = "latest", python = "3.13" }

"gem:cocoapods" = "latest"

# GitHub release binaries
"github:yt-dlp/yt-dlp" = "latest"

# pipx backend (PyPI-only tools, managed via mise)
"pipx:mycli" = "latest"


[env]
MISE_PYTHON_PRECOMPILED_FLAVOR = "install_only_stripped"
MISE_RUSTUP_HOME = "$HOME/.rustup"
MISE_CARGO_HOME = "$HOME/.cargo"
PIP_INDEX_URL = "https://mirrors.aliyun.com/pypi/simple/"
GOPROXY = "https://goproxy.cn,direct"
