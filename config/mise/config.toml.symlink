# mise configuration file
# https://mise.jdx.dev/configuration.html

[settings]
env_shell_expand = true
npm.package_manager = "bun"
cargo.binstall = true
pipx.uvx = true
pipx.registry_url = "https://pypi.tuna.tsinghua.edu.cn/simple/{}/"
python.precompiled_flavor = "install_only_stripped"
task.run_auto_install = false
minimum_release_age = "1d" # 防上游新包投毒冷却期；若需追当日刚发的新版可随时改回 "0s"

[tools]
# ── 1. 核心运行时 (Core runtimes) ─────────────────────────────
node = "22.16"
python = "3.14"
go = "latest"
ruby = "3.4.8"
rust = "stable"
java = "temurin-21" # 显式指定开源免费的 Eclipse Temurin 21 LTS，完美兼容 Gradle/Flutter
bun = "latest"
uv = "latest"
zig = "latest"
deno = "latest"
codex = "latest"
claude-code = "latest"
flutter = "3.47.9"  # 锁定 3.47 成熟稳定分支，无 -stable 后缀，彻底消除版本比对警告

# ── 2. 通用 CLI 工具 (内置 Registry 预编译包) ─────────────────
antigravity-cli = "latest"
bat = "latest"
bottom = "latest"
cheat = "latest"
chezmoi = "latest"
croc = "latest"
direnv = "latest"
duf = "latest"
dust = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
git-filter-repo = "latest"
just = "latest"
kind = "latest"
pnpm = "latest"     # 独立预编译二进制，与 Node 版本升级彻底解耦
protobuf = "latest"
ripgrep = "latest"
rtk = "latest"
ruff = "latest"
starship = "latest"
taplo = "latest"
tealdeer = "latest"
tokei = "latest"
usage = "latest"
websocat = "latest"
xcodegen = "latest"
xh = "latest"
yazi = "latest"
yt-dlp = "latest"   # 内置规则自带 SHA256 校验
zoxide = "latest"

# ── 3. Cargo 后端工具 (含 Intel Mac 架构兜底与 Rust 子命令) ────
# 优先通过 cargo-binstall 拉取预编译包；若上游无 darwin/amd64 资产则自动回退本地编译
"cargo-binstall" = "latest"
"cargo:atuin" = "latest"
"cargo:git-delta" = "latest"
"cargo:sheldon" = "latest"
"cargo:fblog" = "latest"
"cargo:procs" = "latest"
"cargo:tre-command" = "latest"
"cargo:eva" = "latest"
"cargo:rustscan" = "latest"
"cargo:cargo-audit" = "latest"
"cargo:cargo-deny" = "latest"
"cargo:cargo-generate" = "latest"
"cargo:crm" = "latest"
"cargo:typos-cli" = "latest"

# ── 4. Go 工具 ───────────────────────────────────────────────
"go:github.com/gogf/gf/cmd/gf/v2" = "2.10.0"
"go:github.com/ofabry/go-callvis" = "latest"
"go:github.com/a-h/templ/cmd/templ" = "latest"

# ── 5. NPM 工具 (通过 bun 极速安装) ───────────────────────────
"npm:fanyi" = "latest"
"npm:ccusage" = "latest"
"npm:npkill" = "latest"
"npm:prettier" = "latest"
"npm:pake-cli" = "latest"
"npm:http-server" = "latest"
"npm:@moonshot-ai/kimi-code" = "latest"

# ── 6. Python CLI 工具 (复用全局 Python 3.14 + uvx 隔离运行) ──
"pipx:duckduckgo-mcp-server" = "latest"
"pipx:pre-commit" = "latest"
"pipx:mycli" = "latest"

# ── 7. Ruby Gem 工具 ─────────────────────────────────────────
"gem:cocoapods" = "latest"

[env]
MISE_RUSTUP_HOME = "$HOME/.rustup"
MISE_CARGO_HOME = "$HOME/.cargo"
PIP_INDEX_URL = "https://pypi.tuna.tsinghua.edu.cn/simple/"
UV_DEFAULT_INDEX = "https://pypi.tuna.tsinghua.edu.cn/simple/"
GOPROXY = "https://goproxy.cn,direct"
