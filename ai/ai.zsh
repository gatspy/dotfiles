versor() {
	# 标记当前在 shell hook 中调用，versor 会跳过手动 source 提示
	export VERSOR_HOOK_ACTIVE=1
	command versor "$@"
	local exit_code=$?
	if [ $exit_code -eq 0 ] && [ "$1" = "use" ]; then
		local env_script_path
		env_script_path=$(command versor env --path-only 2>/dev/null)
