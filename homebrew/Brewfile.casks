tap "deskflow/tap", trusted: true
tap "xo/xo", trusted: true

# Formulae — M6 whitelist v2.4 (2026-10-27): core 7 + on-demand heavyweights 2.
# grc retired same day: system/grc.zsh deleted; its wrapped-command colorization
# is fully superseded by mise's native-color tools (eza/dust/duf/procs/fd/delta/btm).
# 2026-10-27 purge (MBP-evidenced, zero-live-refs): wget/htop/coreutils retired,
# wireshark retired (formula is CLI-only; user doesn't capture), protobuf retired
# (protoc now mise-owned). imagemagick/libpq never in M6 scope.
# gnupg is MBP-only by ruling. jq stays brew (jaq deviates on $ENV etc.).
# Owned by mise (config.toml) — do not re-add: protobuf, kind, git-filter-repo,
# xcodegen, antigravity-cli, wire, fblog, gemini-cli.
# tmux configs kept in dotfiles for painless reinstall if ever needed.
# All bottled on arm64. App Store apps are installed manually (mas retired).
# system base
brew "git"
brew "curl"
brew "jq"
# build
brew "cmake"
brew "ninja"
# retained per dual-machine ruling
brew "neovim"
brew "mole"
# on-demand heavyweights (yearly upgrades)
brew "ffmpeg"
brew "radare2"

# ---- Casks: M6 birth set v2 (20), trimmed per 2026-10-26 ruling ----
# Open source IDE for exploring and testing APIs
cask "bruno"
# Mouse and keyboard sharing utility
cask "deskflow/tap/deskflow"
# Web browser
cask "google-chrome"
# Desktop automation application
cask "hammerspoon"
# Free and open-source media player
cask "iina"
# Tool to optimise images to a smaller size
cask "imageoptim"
# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Menu bar manager
cask "jordanbaird-ice"
# File archiver
cask "keka"
# Open-source cross-platform alternative to AirDrop
cask "localsend"
# Visualiser for neural network, deep learning, and machine learning models
cask "netron"
# App to write, plan, collaborate, and get organised
cask "notion"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
# Replacement for Docker Desktop
cask "orbstack"
# Quick Look generator for Markdown files
cask "qlmarkdown"
# Displays all open files and sockets in use by all running processes
cask "sloth"
# Rime input method engine
cask "squirrel-app"
# App to switch hosts
cask "switchhosts"
# Configurable document editor that supports Markdown
cask "typora"
# Multiplayer code editor
cask "zed"

# mas stanza removed 2026-10-26: App Store apps (incl. Xcode) are installed
# manually via the App Store per user ruling.

# vscode stanza removed 2026-10-26: visual-studio-code is MBP-only legacy,
# M6 runs Zed + Antigravity; full stanza recoverable from git history.
# wire/fblog/gemini-cli are owned by mise (config.toml) — do not re-add here
cargo "cargo-asm"
cargo "cargo-audit"
cargo "cargo-edit"
cargo "cargo-expand"
cargo "cargo-llvm-cov"
cargo "cargo-tarpaulin"
cargo "cbindgen"
cargo "crm"
cargo "flutter_rust_bridge_codegen"
cargo "git-cliff"
cargo "gql"
cargo "irust"
cargo "pijul"
npm "corepack"
